    {"name": "native-jma-zstd2bit-fixed-64k", "command": ["jam", "archive", "--sequence-codec", "zstd2bit", "--block-bases", "65536"], "metadata": {"backend": "native_jma", "codec": "zstd2bit", "policy": "fixed"}},
    {"name": "pithos-packed-slabs", "command": ["jam", "archive", "--backend", "pithos", "--sequence-policy", "packed-slabs"], "metadata": {"backend": "pithos", "policy": "packed_slabs"}}
  ]
}
